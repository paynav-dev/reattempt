{
  "name": "@paynav/reattempt",
  "version": "0.1.2",
  "description": "Card-network retry-compliance engine: decide whether a declined Visa/Mastercard card-not-present transaction may be reattempted, why, the fee risk, and when the next attempt becomes eligible.",
  "keywords": [
    "visa",
    "mastercard",
    "decline",
    "declined",
    "retry",
    "reattempt",
    "resubmission",
    "dunning",
    "subscription",
    "billing",
    "payments",
    "card-not-present",
    "merchant-advice-code",
    "compliance",
    "network-fees"
  ],
  "license": "MIT",
  "author": "paynav <ajh@paynav.dev>",
  "homepage": "https://github.com/paynav-dev/reattempt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paynav-dev/reattempt.git"
  },
  "bugs": {
    "url": "https://github.com/paynav-dev/reattempt/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
